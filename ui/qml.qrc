<!DOCTYPE RCC>
<RCC version="1.0">
    <!--
        本文件位于 ui/ 目录下。
        使用 prefix="/ui" + 相对路径 "qml/..."，
        最终资源路径仍然保持为：
        qrc:/ui/qml/Main.qml
        qrc:/ui/qml/Theme.qml
        等等，与 C++ 中的 engine.load(QUrl("qrc:/ui/qml/Main.qml")) 完全一致。
    -->
    <qresource prefix="/ui">
        <file>qml/Main.qml</file>
        <file>qml/Theme.qml</file>
        <file>qml/qmldir</file>

        <file>qml/pages/HomePage.qml</file>
        <file>qml/pages/AddPage.qml</file>
        <file>qml/pages/RosterPage.qml</file>
        <file>qml/pages/HistoryPage.qml</file>
        <file>qml/pages/ToolsPage.qml</file>
        <file>qml/pages/SettingsPage.qml</file>

        <file>qml/components/WheelItem.qml</file>
        <file>qml/components/ResultCard.qml</file>
        <file>qml/components/CardShadow.qml</file>
        <file>qml/components/CardShadowBehind.qml</file>

        <file>assets/app-icon-512.png</file>
    </qresource>
</RCC>
